# Copy to .env and fill in. NEVER commit .env.
OTARI_API_KEY=
OTARI_BASE_URL=https://otari.ai/api/v1
# Public https URL of this backend (e.g. https://creeping-hunger.onrender.com or a tunnel).
# When set, Otari itself calls our /guardrail/validate service (request-level guardrail url).
PUBLIC_BASE_URL=
# Public https URL of the MCP server's streamable-HTTP endpoint, e.g. https://ch-mcp.fly.dev/mcp
MCP_PUBLIC_URL=
# 1 = send the anonymous install id as `user` (needs an Otari *service key* for per-user budgets)
OTARI_SEND_END_USER=1
# Optional: name of a routing policy created in the Otari dashboard for the judge
JUDGE_POLICY=
EXTRACTOR_MODEL=alibaba/qwen3-30b-a3b-instruct-2507
RESEARCH_MODEL=openai/gpt-oss-120b
JUDGE_PRIMARY=meta/llama-3.3-70b-instruct
JUDGE_FALLBACK=mistralai/mistral-small-3.2-24b-instruct-2506
GUARD_MODEL=openai/gpt-oss-safeguard-120b
